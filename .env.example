# Secret de session (obligatoire) — génère-le avec : openssl rand -hex 32
SESSION_SECRET=

# Mettre "false" UNIQUEMENT pour un déploiement en HTTP clair sur un réseau local
# de confiance (sinon laisser vide : cookie Secure en production, HTTPS requis).
SESSION_SECURE=

# Planification de la vérification des annonces (cron, heure locale du serveur)
CHECK_CRON=17 */6 * * *
# Pause entre deux requêtes vers Leboncoin, en millisecondes
CHECK_DELAY_MS=4000

# Actualisation quotidienne des taux immobiliers officiels (Banque de France, via eco3min)
RATES_CRON=13 7 * * *
